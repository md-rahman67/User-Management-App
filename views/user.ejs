<% layout("/layouts/boilerplate") %>

    <body>
        <!-- <h1 style="display: inline;">Users List</h1>
        &nbsp;&nbsp;&nbsp;&nbsp;
        <a href="/">Home</a>
        &nbsp;&nbsp;&nbsp;&nbsp;
        <a href="/user/add">Register new user</a> -->
        <div class="tbl" style="border-radius: 1rem !important;">

            <table style="border-spacing: 5px 10px;" class="table table-hover">
                <thead class="table-primary">
                    <tr class="theme-info">
                        <th scope="col">ID</th>
                        <th scope="col">Username</th>
                        <th scope="col">Email</th>
                        <th scope="col">Actions</th>
                        <th scope="col">Delete</th>
                    </tr>
                </thead>

                <tbody>
                    <% for(user of users){ %>
                        <tr>
                            <td>
                                <%= user.id.slice(0,8) %>...
                            </td>
                            <td>
                                <%= user.username %>
                            </td>
                            <td>
                                <%= user.email %>
                            </td>
                            <td>
                                <form action="/user/<%= user.id %>/edit">
                                    <button class="btn btn-primary">Edit</button>
                                </form>
                            </td>

                            <td>
                                <form action="/delete/<%= user.id %>/<%= user.username %>" method="get">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </td>

                        </tr>

                        <% } %>
                </tbody>
            </table>
        </div>
    </body>